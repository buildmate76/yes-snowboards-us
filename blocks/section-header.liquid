{% assign block_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .yes-header-{{ block_id }} {
    display: block;
    background-color: {{ block.settings.bg_color }};
    width: 100%;
  }

  .yes-header-container-{{ block_id }} {
    max-width: 1440px;
    width: 100%;
    margin: 0 auto;
    padding: {{ block.settings.padding_top }}px 70px {{ block.settings.padding_bottom }}px;
  }

  .yes-header-toggle-{{ block_id }} {
    display: flex;
    align-items: center;
    justify-content: space-between;
    cursor: pointer;
    padding: 16px 0;
    border-top: 1px solid var(--color-blue-light);
    user-select: none;
  }

  .yes-header-title-{{ block_id }} {
    font-family: "The Wave", Wave, Arial, sans-serif;
    font-weight: 700;
    font-size: 24px;
    text-transform: none;
    margin: 0;
    color: #000000;
  }

  .yes-header-chevron-{{ block_id }} {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    transition: transform 0.3s ease;
    flex-shrink: 0;
  }

  .yes-header-chevron-{{ block_id }} svg {
    width: 20px;
    height: 20px;
    stroke: var(--color-blue-light);
    stroke-width: 5;
  }

  .yes-header-chevron-{{ block_id }}.collapsed {
    transform: rotate(-180deg);
  }

  @media screen and (max-width: 768px) {
    .yes-header-container-{{ block_id }} {
      padding: {{ block.settings.padding_top }}px 20px {{ block.settings.padding_bottom }}px;
    }

    .yes-header-title-{{ block_id }} {
      font-size: 20px;
    }
  }
{% endstyle %}

<yes-section-header-{{ block_id }} class="yes-header-{{ block_id }}" {{ block.shopify_attributes }}>
  <div class="yes-header-container-{{ block_id }}">
    <div class="yes-header-toggle-{{ block_id }}" data-toggle aria-expanded="true">
      <h2 class="yes-header-title-{{ block_id }}">{{ block.settings.title }}</h2>
      <span class="yes-header-chevron-{{ block_id }}">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
        </svg>
      </span>
    </div>
  </div>
</yes-section-header-{{ block_id }}>

<script>
  (function() {
    if (customElements.get('yes-section-header-{{ block_id }}')) return;

    class YesSectionHeader{{ block_id }} extends HTMLElement {
      connectedCallback() {
        this.toggle = this.querySelector('[data-toggle]');
        this.chevron = this.querySelector('.yes-header-chevron-{{ block_id }}');
        this.isExpanded = true;
        this.toggle.addEventListener('click', () => this.handleToggle());
      }

      handleToggle() {
        this.isExpanded = !this.isExpanded;
        this.toggle.setAttribute('aria-expanded', String(this.isExpanded));
        this.chevron.classList.toggle('collapsed', !this.isExpanded);
        document.dispatchEvent(new CustomEvent('yes:section-toggle', {
          detail: { sectionId: '{{ block_id }}', expanded: this.isExpanded }
        }));
      }
    }

    customElements.define('yes-section-header-{{ block_id }}', YesSectionHeader{{ block_id }});
  })();
</script>

{% schema %}
{
  "name": "Section Header",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Features & Constructions"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 0
    }
  ],
  "presets": [
    { "name": "Section Header" }
  ]
}
{% endschema %}
