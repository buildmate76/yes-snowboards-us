      "blocks": {
        "text_attWe4": {
          "type": "text",
          "settings": {
            "text": "<p>The YES Pro Program is open to our family of authorized dealers, industry affiliates and professional mountain guides. All people who live and breathe snowboarding and work in our industry full time.</p><p>We're honored to partner with these riders as they are working toward the same goals we are - to help others get in the mountains and enjoy wild natural experiences, and to use those influential wilderness experiences to help protect the planet.</p><p>If you feel you qualify for the YES Pro Program, don't hesitate to apply now. </p>"
          }
        },
        "heading_76FwDH": {
          "type": "heading",
          "settings": {
            "heading": "Start application",
            "heading_size": "h2"
          }
        },
        "text_Aw6xeV": {
          "type": "text",
          "settings": {
            "text": "<p>The first step is to sign in or create an account. If you are applying as an industry professional, please sign up using your work email address. Return to this page to continue the process.</p>"
          }
        },
        "button_fLwxtH": {
          "type": "button",
          "settings": {
