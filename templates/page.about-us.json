    "rich_text_rNJzPP": {
      "type": "rich-text",
      "blocks": {
        "text_yhQBQY": {
          "type": "text",
          "settings": {
            "text": "<p>YES it's happening!! Super exciting times ahead as Lobster, NOW and YES have joined forces under one brand with a mission to empower freestyle snowboard enthusiasts in this universe to reach new levels of fun and creativity.</p><p>YES, we want to ignite that stoke-fire within and inspire you to have as much fun as humanly possible while riding sideways. Snowboarding should be fun and that's at the core of everything we do.</p><p>YES you can join us on our new journey by sending it each and every day. Dream big, cream big and never forget that take offs are always mandatory and landings are most definitely optional.</p><p>YES, LET'S GO SNOWBOARDING!!!\"</p>"
          }
        }
      },
      "block_order": [
        "text_yhQBQY"
      ],
