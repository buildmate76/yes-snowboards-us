{{ 'section-accordion.css' | asset_url | stylesheet_tag }}
{{ 'page-warranty.css' | asset_url | stylesheet_tag }}

{% include 'global-variables' %}

<div class="page-warranty page-spacing-bottom">
	<div class="page-width">
		<div class="container">
			<section class="menu">
				<ul>
					<li class="mobile">
						<div class="accordion">
							<details open>
								<summary id="warranty">
									<h3 class="menu-accordion-title">WARRANTY</h3>
								</summary>

								<div class="content">
									<a
										href="/pages/warranty"
										class="{% if current_url_path == '/pages/warranty' %}active{% endif %}"
									>
										<h4 class="subtitle">Warranty introduction</h4>
									</a>
									<a
										href="/pages/warranty-returning"
										class="{% if current_url_path == '/pages/warranty-returning' %}active{% endif %}"
									>
										<h4 class="subtitle">Returning product for warranty/repairs</h4>
									</a>
									<a
										href="/pages/warranty-period"
										class="{% if current_url_path == '/pages/warranty-period' %}active{% endif %}"
									>
										<h4 class="subtitle">Warranty Period</h4>
									</a>
									<a
										href="/pages/warranty-limitations"
										class="{% if current_url_path == '/pages/warranty-limitations' %}active{% endif %}"
									>
										<h4 class="subtitle">Warranty Limitations</h4>
									</a>
									<a
										href="/pages/warranty-additional-information"
										class="{% if current_url_path == '/pages/warranty-additional-information' %}active{% endif %}"
									>
										<h4 class="subtitle">Additional information</h4>
									</a>
								</div>

								<div class="content-text large-up-hide">
									<h1 class="main-page-title page-title">
										{{ page.title | escape }}
									</h1>
									<div>
										{{ page.content }}
									</div>
								</div>
							</details>
						</div>
					</li>
					<li class="desktop">
						<div class="content">
							<a
								href="/pages/warranty"
								class="{% if current_url_path == '/pages/warranty' %}active{% endif %}"
							>
								<h3>Warranty {% render 'icon-arrow' %} </h3>
							</a>
							<a
								href="/pages/warranty-returning"
								class="{% if current_url_path == '/pages/warranty-returning' %}active{% endif %}"
							>
								<h4 class="subtitle">Returning product for warranty/repairs</h4>
							</a>
							<a
								href="/pages/warranty-period"
								class="{% if current_url_path == '/pages/warranty-period' %}active{% endif %}"
							>
								<h4 class="subtitle">Warranty Period</h4>
							</a>
							<a
								href="/pages/warranty-limitations"
								class="{% if current_url_path == '/pages/warranty-limitations' %}active{% endif %}"
							>
								<h4 class="subtitle">Warranty Limitations</h4>
							</a>
							<a
								href="/pages/warranty-additional-information"
								class="{% if current_url_path == '/pages/warranty-additional-information' %}active{% endif %}"
							>
								<h4 class="subtitle">Additional information</h4>
							</a>
						</div>
					</li>

					<li>
						<a href="/pages/ordering-returns-policies"><h4 class="h3">Shipping & Returns</h4></a>
					</li>
					<li>
						<a href="/pages/contact"><h4 class="h3">Contact Us</h4></a>
					</li>
				</ul>
			</section>



			<section class="page-content small-hide medium-hide">
				<div>
					<h1 class="main-page-title page-title">
						{{ page.title | escape }}
					</h1>
					<div>
						{{ page.content }}
					</div>
				</div>
			</section>
		</div>
	</div>
</div>

{% schema %}
{
	"name": "Page Warranty",
	"tag": "section",
	"class": "section",
	"settings": [
		{
			"type": "header",
			"content": "Warranty"
		}
	]
}
{% endschema %}
