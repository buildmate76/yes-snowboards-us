{%- liquid
  assign heading_color = section.settings.heading_color
  assign bg_color = section.settings.bg_color
  assign padding_top = section.settings.padding_top
  assign padding_bottom = section.settings.padding_bottom
  assign columns = section.settings.columns_desktop
  assign gap_desktop = section.settings.gap_desktop
  assign gap_mobile = section.settings.gap_mobile
  assign radius_desktop = section.settings.radius_desktop
  assign radius_mobile = section.settings.radius_mobile
-%}

<section class="team-section" style="
  background-color: {{ bg_color }};
  padding-top: {{ padding_top }}px;
  padding-bottom: {{ padding_bottom }}px;
">
  <div class="team-inner">
    {%- if section.settings.heading != blank -%}
      <h3 class="team-heading" style="color: {{ heading_color }}; font-size: {{ section.settings.heading_size }}px;">
        {{ section.settings.heading }}
      </h3>
    {%- endif -%}

    <div class="team-grid" style="
      --columns: {{ columns }};
      --gap-desktop: {{ gap_desktop }}px;
      --gap-mobile: {{ gap_mobile }}px;
      --radius-desktop: {{ radius_desktop }}px;
      --radius-mobile: {{ radius_mobile }}px;
    ">
      {%- for block in section.blocks -%}
        {%- if block.type == 'member' -%}
          <div class="team-card" {{ block.shopify_attributes }}>
            <a class="team-card__link" href="{{ block.settings.link }}">
              <div class="team-card__media">
                {%- if block.settings.image != blank -%}
                  {{ block.settings.image | image_url: width: 800 | image_tag: loading: 'lazy', class: 'team-card__img' }}
                {%- else -%}
                  <div class="team-card__placeholder">{{ 'image' | placeholder_svg_tag }}</div>
                {%- endif -%}

                {%- if block.settings.icon != blank -%}
                  <span class="team-card__icon">
                    {{ block.settings.icon | image_url: width: 40 | image_tag: loading: 'lazy' }}
                  </span>
                {%- endif -%}

                <div class="team-card__overlay">
                  <span class="member-name">{{ block.settings.name }}</span>
                  <span class="member-link">{{ block.settings.label }}</span>
                </div>
              </div>

              <div class="team-card__below">
                <span class="member-name--mobile">{{ block.settings.name }}</span>
                <span class="member-link--mobile">{{ block.settings.label }} →</span>
              </div>
            </a>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

<style>
  .team-section {
    width: 100%;
  }

  .team-inner {
    max-width: 1440px;
    margin: 0 auto;
    padding-inline: 70px;
  }

  .team-heading {
    font-family: "The Wave", Wave, Arial, sans-serif;;
    font-weight: 700;
    margin-bottom: 50px;
    text-transform: none;
  }

  .team-grid {
    display: grid;
    grid-template-columns: repeat(var(--columns), 1fr);
    gap: var(--gap-desktop);
  }

  .team-card {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-desktop);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.1);
    transition: transform 0.3s ease;
  }

  .team-card:hover {
    transform: scale(1.02);
  }

  .team-card__link {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .team-card__media {
    position: relative;
    aspect-ratio: 3 / 4;
    overflow: hidden;
  }

  .team-card__img {
    width: 100%;
    height: 100%;
    filter: brightness(80%);
    object-fit: cover;
    display: block;
  }

  .team-card__placeholder {
    width: 100%;
    height: 100%;
    background: #f0f0f0;
  }

  .team-card__icon {
    position: absolute;
    top: 21px;
    right: 16px;
    width: 47px;
    height: 47px;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 1;
  }

  .team-card__icon img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .team-card__overlay {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 48px 20px 16px;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .member-name {
    color: #fff;
    font-family: "The Wave", Wave, Arial, sans-serif;;
    font-weight: 700;
    font-size: 18px;
  }

  .member-link {
    color: #fff;
    font-family: "The Wave", Wave, Arial, sans-serif;;
    font-size: 12px;
    text-decoration: underline;
  }

  .team-card__below {
    display: none;
  }

  .member-name--mobile,
  .member-link--mobile {
    display: none;
  }

  @media (max-width: 767px) {
    .team-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--gap-mobile);
    }

    .team-inner {
      padding-inline: 20px;
    }

    .team-card {
      border-radius: var(--radius-mobile);
      box-shadow: none;
    }

    .team-card__overlay {
      display: none;
    }

    .team-card__icon {
      display: none;
    }

    .team-card__below {
      display: flex;
      flex-direction: column;
      gap: 4px;
      padding-top: 8px;
    }

    .member-name--mobile {
      display: block;
      font-weight: 700;
      font-size: 14px;
      color: #111;
    }

    .member-link--mobile {
      display: block;
      font-size: 13px;
      color: #666;
      text-decoration: none;
    }
  }
</style>

{% schema %}
{
  "name": "Meet the YES Team",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Meet the YES team" },
    { "type": "range", "id": "heading_size", "label": "Heading size", "min": 16, "max": 64, "step": 2, "default": 32, "unit": "px" },
    { "type": "color", "id": "heading_color", "label": "Heading color", "default": "#000000" },
    { "type": "color", "id": "bg_color", "label": "Background color", "default": "#ffffff" },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 100, "step": 4, "default": 48, "unit": "px" },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 100, "step": 4, "default": 48, "unit": "px" },
    { "type": "range", "id": "columns_desktop", "label": "Desktop columns", "min": 2, "max": 6, "step": 1, "default": 4 },
    { "type": "range", "id": "gap_desktop", "label": "Desktop gap", "min": 8, "max": 48, "step": 4, "default": 24, "unit": "px" },
    { "type": "range", "id": "gap_mobile", "label": "Mobile gap", "min": 8, "max": 32, "step": 4, "default": 16, "unit": "px" },
    { "type": "range", "id": "radius_desktop", "label": "Border radius desktop", "min": 0, "max": 40, "step": 2, "default": 20, "unit": "px" },
    { "type": "range", "id": "radius_mobile", "label": "Border radius mobile", "min": 0, "max": 24, "step": 2, "default": 12, "unit": "px" }
  ],
  "blocks": [
    {
      "type": "member",
      "name": "Team Member",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Photo" },
        { "type": "image_picker", "id": "icon", "label": "Icon (desktop only)" },
        { "type": "text", "id": "name", "label": "Rider name", "default": "Rider Name" },
        { "type": "url", "id": "link", "label": "Link URL" },
        { "type": "text", "id": "label", "label": "Button label", "default": "Learn More" }
      ]
    }
  ],
  "presets": [{ "name": "Meet the YES Team" }]
}
{% endschema %}
