<section class="home-meet-team">
    <div class="page-width home-meet-team__inner">
        <div class="home-meet-team__header">
            {% if section.settings.heading != blank %}
                <h2 class="home-meet-team__heading" style="color: {{ section.settings.heading_color }};">
                    {{ section.settings.heading }}
                </h2>
            {% endif %}

            {% if section.settings.description != blank %}
                <div class="home-meet-team__description" style="color: {{ section.settings.text_color }};">
                    {{ section.settings.description }}
                </div>
            {% endif %}

            {% if section.settings.cta_text != blank and section.settings.cta_link != blank %}
                <a class="home-meet-team__cta" href="{{ section.settings.cta_link }}">
                    {{ section.settings.cta_text }}
                </a>
            {% endif %}
        </div>

        <div class="home-meet-team__carousel">
            {% render 'card-profile', home_style: true %}
        </div>

        <div class="home-meet-team__nav-row">
            <button class="home-meet-team__nav home-meet-team__nav--prev" type="button" aria-label="Previous team members">
                <svg width="800px" height="800px" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M6 12H18M6 12L11 7M6 12L11 17" stroke="#000000" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
            </button>
            <button class="home-meet-team__nav home-meet-team__nav--next" type="button" aria-label="Next team members">
                <svg width="800px" height="800px" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M6 12H18M18 12L13 7M18 12L13 17" stroke="#000000" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
            </button>
        </div>
    </div>
</section>

<style>
    .home-meet-team {
        background: {{ section.settings.bg_color }};
        padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
    }

    .home-meet-team__inner {
        position: relative;
    }

    .home-meet-team__header {
        display: flex;
        flex-direction: column;
        align-items: start;
        gap: 24px;
        margin-bottom: 48px;
    }

    .home-meet-team__heading {
        font-family: "The Wave", Wave, Arial, sans-serif;
        font-size: 24px;
        font-style: normal;
        font-weight: 400;
        line-height: normal;
        text-transform: uppercase;
        margin: 0;
    }

    .home-meet-team__description {
        margin: 0;
        font-size: 14px;
        line-height: 1.6;
        max-width: 620px;
        opacity: 0.82;
    }

    .home-meet-team__description p {
        font-family: "The Wave", Wave, Arial, sans-serif;
        font-size: 13.5px;
        font-style: normal;
        font-weight: 400;
        line-height: 21px;
        margin: 0;
    }

    .home-meet-team__cta {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: var(--color-black);
        color: var(--color-white);
        min-height: 28.125px;
        border-radius: 16.875px;
        padding: 12px 20px;
        text-align: center;
        font-family: "The Wave", Wave, Arial, sans-serif;
        font-size: 11.25px;
        font-style: normal;
        font-weight: 700;
        line-height: normal;
        text-decoration: none;
    }

    .home-meet-team__carousel {
        position: relative;
        display: flex;
        align-items: center;
        gap: 20px;
    }

    .home-meet-team__nav-row {
        display: flex;
        align-items: center;
        margin-top: 18px;
        padding-left: 2px;
    }

    .home-meet-team__nav {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 42px;
        height: 42px;
        border: none;
        color: var(--color-black);
        background-color: transparent;
        cursor: pointer;
        transition: all 0.2s ease;
    }

    .home-meet-team__nav svg {
        width: 18px;
        height: 18px;
        display: block;
    }

    .card-profile--home {
        width: 100%;
        overflow: hidden;
    }

    .card-profile--home .card-profile__track {
        display: flex;
        gap: 22px;
        overflow-x: auto;
        scrollbar-width: none;
        scroll-snap-type: x proximity;
        padding-bottom: 8px;
        padding-left: 2px;
        padding-right: 2px;
        -webkit-overflow-scrolling: touch;
    }

    .card-profile--home .card-profile__track::-webkit-scrollbar {
        display: none;
    }

    .card-profile--home .card-profile__item {
        position: relative;
        flex: 0 0 calc((100% - 66px) / 4);
        min-width: 0;
        scroll-snap-align: start;
        border-radius: 24px;
        overflow: hidden;
        background: #efefef;
        border: none;
        padding: 0;
        transition: transform 0.25s ease;
        border-radius: 18.75px;
        border: 0.75px solid var(--color-gray-dark);
    }

    .card-profile--home .card-profile__item:hover {
        transform: translateY(-3px);
    }

    .card-profile--home .card-profile__media {
        position: relative;
        width: 100%;
        aspect-ratio: 0.78;
        overflow: hidden;
        border-radius: 24px;
        background: #ebebeb;
    }

    .card-profile--home .card-profile__image {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
        transition: opacity 0.25s ease;
    }

    .card-profile--home .card-profile__image.default {
        opacity: 1;
    }

    .card-profile--home .card-profile__image.hover {
        opacity: 0;
    }

    .card-profile--home .card-profile__item:hover .card-profile__image.default {
        opacity: 0;
    }

    .card-profile--home .card-profile__item:hover .card-profile__image.hover {
        opacity: 1;
    }

    .card-profile--home .card-profile__placeholder {
        position: absolute;
        inset: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #efefef;
    }

    .card-profile--home .card-profile__content {
        position: absolute;
        z-index: 2;
        inset: 0;
        display: flex;
        flex-direction: column;
        justify-content: flex-start;
        padding: 22px 20px 18px;
    }

    .card-profile--home .card-profile__role {
        text-align: center;
        font-family: "The Wave", Wave, Arial, sans-serif;
        font-size: 12px;
        font-style: normal;
        font-weight: 400;
        line-height: 15px;
    }

    .card-profile--home .card-profile__name {
        text-align: center;
        font-family: "The Wave", Wave, Arial, sans-serif;
        font-size: 24.517px;
        font-style: normal;
        font-weight: 400;
        line-height: 32.69px;
    }

    .card-profile--home .card-profile__link {
        position: absolute;
        left: 50%;
        bottom: 18px;
        transform: translateX(-50%);
        z-index: 3;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: calc(100% - 32px);
        min-height: 28px;
        background: var(--color-white);
        border-radius: 16.875px;
        color: var(--color-black);
        text-transform: uppercase;
        text-decoration: none;
        text-align: center;
        font-family: "The Wave", Wave, Arial, sans-serif;
        font-size: 11.25px;
        font-style: normal;
        font-weight: 700;
        line-height: normal;
    }

    @media screen and (max-width: 989px) {
        .card-profile--home .card-profile__item {
            flex-basis: calc((100% - 22px) / 2);
        }

        .home-meet-team__header {
            grid-template-columns: 1fr;
            gap: 16px;
        }

        .home-meet-team__cta {
            justify-self: start;
        }
    }

    @media screen and (max-width: 767px) {
        .home-meet-team {
            padding-top: 32px;
            padding-bottom: 32px;
        }

        .home-meet-team__carousel {
            gap: 12px;
        }

        .home-meet-team__nav {
            display: none;
        }

        .card-profile--home .card-profile__item {
            flex-basis: calc((100% - 12px) / 2);
        }

        .card-profile--home .card-profile__link {
            font-size: 10px;
        }
    }
</style>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        document.querySelectorAll('.home-meet-team').forEach(function (sectionEl) {
        const track = sectionEl.querySelector('.card-profile__track');
        const prevBtn = sectionEl.querySelector('.home-meet-team__nav--prev');
        const nextBtn = sectionEl.querySelector('.home-meet-team__nav--next');

        if (!track || !prevBtn || !nextBtn) return;

        const step = function () {
            const firstCard = track.querySelector('.card-profile__item');
            if (!firstCard) return 280;
            return firstCard.getBoundingClientRect().width + 22;
        };

        const updateArrows = function () {
            const atStart = track.scrollLeft <= 8;
            const atEnd = track.scrollLeft + track.clientWidth >= track.scrollWidth - 8;

            prevBtn.disabled = atStart;
            prevBtn.style.opacity = atStart ? '0.45' : '1';
            prevBtn.style.pointerEvents = atStart ? 'none' : 'auto';

            nextBtn.disabled = atEnd;
            nextBtn.style.opacity = atEnd ? '0.45' : '1';
            nextBtn.style.pointerEvents = atEnd ? 'none' : 'auto';
        };

        prevBtn.addEventListener('click', function () {
            track.scrollBy({ left: -step(), behavior: 'smooth' });
        });

        nextBtn.addEventListener('click', function () {
            track.scrollBy({ left: step(), behavior: 'smooth' });
        });

        track.addEventListener('scroll', updateArrows, { passive: true });
        updateArrows();
        });
    });
</script>

{% schema %}
{
  "name": "Home Meet the Team",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Meet the Team"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#111111"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Lorem ipsum dolor sit amet, consectetur adipiscing elit. Praesent nisl felis, condimentum nec mi quis, aliquet molestie nisi.</p>"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Description color",
      "default": "#111111"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "CTA text",
      "default": "See Full Team"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "CTA link"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#f5f5f3"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 48,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 48,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "team_member",
      "name": "Team member",
      "settings": [
        {
          "type": "text",
          "id": "name",
          "label": "Name",
          "default": "Rider Name"
        },
        {
          "type": "text",
          "id": "role",
          "label": "Role",
          "default": "Team Rider"
        },
        {
          "type": "url",
          "id": "url_instagram",
          "label": "Instagram URL"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label",
          "default": "Meet Rider"
        },
        {
          "type": "image_picker",
          "id": "image_default",
          "label": "Photo - default"
        },
        {
          "type": "image_picker",
          "id": "image_hover",
          "label": "Photo - hover"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Home Meet the Team",
      "blocks": [
        { "type": "team_member" },
        { "type": "team_member" },
        { "type": "team_member" },
        { "type": "team_member" }
      ]
    }
  ]
}
{% endschema %}
