<script>
    var customer_tags = "{{ customer.tags | join: ',' }}";

    document.addEventListener('DOMContentLoaded', function () {

        // Convert the tags string to an array by splitting on the comma
        var tagsArray = customer_tags.split(',').map(tag => tag.trim());

        // Check if "proform" is one of the tags
        if (tagsArray.includes("proform")) {
                var discountField = document.querySelector('.limoniapps-discountninja-cartdiscountfield-placeholder');
                var discountninjaCustombloc = document.querySelector('main#MainContent .discountninja-custombloc');

                if (discountField && discountninjaCustombloc) {
                    discountField.style.display = 'none';
                    discountninjaCustombloc.style.display = 'none';
                }
        }
    });
</script>
