<modal-dialog
	id="PopupModal-sc"
	class="product-popup-modal"
	{{ block.shopify_attributes }}
>
	<div
		role="dialog"
		aria-label="{{ block.settings.text }}"
		aria-modal="true"
		class="product-popup-modal__content"
		tabindex="-1"
	>
		<button
			id="ModalClose-{{ block.id }}"
			type="button"
			class="product-popup-modal__toggle"
			aria-label="{{ 'accessibility.close' | t }}"
		>
			{% render 'icon-close' %}
		</button>
		<div class="product-popup-modal__content-info">
			<h2>Size details</h2>
			<p>Use this chart to find the right size</p>
			<table id="data-table">
				{% if collection == 'snowboards' %}
					<tr>
						<th>size</th>
						{% for variant in product.variants %}
							<th>{{ variant.title }}</th>

							{% assign loop_count = forloop.index | minus: 1 %}
						{% endfor %}
					</tr>
					{% unless tip_length == blank %}
						<tr>
							<td>Tip length (cm)</td>
							{% for loop in (0..loop_count) %}
								<td>
									{{ tip_length[loop] }}
								</td>
							{% endfor %}
						</tr>
					{% endunless %}
					<tr>
						<td>Tail length (cm)</td>
						{% for loop in (0..loop_count) %}
							<td>
								{{ tail_length[loop] }}
							</td>
						{% endfor %}
					</tr>
					<tr>
						<td>Contact length (cm)</td>
						{% for loop in (0..loop_count) %}
							<td>
								{{ contact_length[loop] }}
							</td>
						{% endfor %}
					</tr>
					<tr>
						<td>Sidecut radius (m)</td>
						{% for loop in (0..loop_count) %}
							<td>
								{{ sidecut_radius[loop] }}
							</td>
						{% endfor %}
					</tr>
					<tr>
						<td>Effective edge length (cm)</td>
						{% for loop in (0..loop_count) %}
							<td>
								{{ effective_edge_length[loop] }}
							</td>
						{% endfor %}
					</tr>
					<tr>
						<td>Taper (mm)</td>
						{% for loop in (0..loop_count) %}
							<td>
								{{ taper[loop] }}
							</td>
						{% endfor %}
					</tr>
					<tr>
						<td>Tip width (cm)</td>
						{% for loop in (0..loop_count) %}
							<td>
								{{ tip_width[loop] }}
							</td>
						{% endfor %}
					</tr>
					<tr>
						<td>Underfoot width : front (cm)</td>
						{% for loop in (0..loop_count) %}
							<td>
								{{ underfoot_width_front[loop] }}
							</td>
						{% endfor %}
					</tr>
					<tr>
						<td>Waist width (cm)</td>
						{% for loop in (0..loop_count) %}
							<td>
								{{ waist_width[loop] }}
							</td>
						{% endfor %}
					</tr>
					<tr>
						<td>Underfoot width : rear (cm)</td>
						{% for loop in (0..loop_count) %}
							<td>
								{{ underfoot_width_rear[loop] }}
							</td>
						{% endfor %}
					</tr>
					<tr>
						<td>Tail width (cm)</td>
						{% for loop in (0..loop_count) %}
							<td>
								{{ tail_width[loop] }}
							</td>
						{% endfor %}
					</tr>
					<tr>
						<td>Reference stance (cm)</td>
						{% for loop in (0..loop_count) %}
							<td>
								{{ reference_stance[loop] }}
							</td>
						{% endfor %}
					</tr>
					<tr>
						<td>Centered stance (cm)</td>
						{% for loop in (0..loop_count) %}
							<td>
								{{ centered_stance[loop] }}
							</td>
						{% endfor %}
					</tr>
					<tr>
						<td>Min stance (cm)</td>
						{% for loop in (0..loop_count) %}
							<td>
								{{ min_stance[loop] }}
							</td>
						{% endfor %}
					</tr>
					<tr>
						<td>Max stance (cm)</td>
						{% for loop in (0..loop_count) %}
							<td>
								{{ max_stance[loop] }}
							</td>
						{% endfor %}
					</tr>
					<tr>
						<td>Setback (mm)</td>
						{% for loop in (0..loop_count) %}
							<td>
								{{ setback[loop] }}
							</td>
						{% endfor %}
					</tr>
					<tr>
						<td>Rider weight (kg)</td>
						{% for loop in (0..loop_count) %}
							<td>
								{{ rider_weight_kg[loop] }}
							</td>
						{% endfor %}
					</tr>
					<tr>
						<td>Rider weight (lbs)</td>
						{% for loop in (0..loop_count) %}
							<td>
								{{ rider_weight_lbs[loop] }}
							</td>
						{% endfor %}
					</tr>
				{% endif %}
				{% if collection == 'bindings' %}
					{% if is_women %}
						<tr>
							<th>Women's</th>
							<th>Small</th>
							<th>Medium</th>
						</tr>
						<tr>
							<td>US</td>
							<td>5.0 - 8.5</td>
							<td>9.0 - 11.5</td>
						</tr>
						<tr>
							<td>EU</td>
							<td>35 -39.5</td>
							<td>40 - 42.5</td>
						</tr>
						<tr>
							<td>MD</td>
							<td>22 - 25</td>
							<td>25.5 - 27.5</td>
						</tr>

					{% else %}
						<tr>
							<th>Men's / Youth</th>
							<th>Small</th>
							<th>Medium</th>
							<th>Large</th>
						</tr>
						<tr>
							<td>US</td>
							<td>5.0 - 7.0</td>
							<td>7.5 - 10.0</td>
							<td>10.5 +</td>
						</tr>
						<tr>
							<td>EU</td>
							<td>36.5 -39.5</td>
							<td>40 - 43</td>
							<td>43.5 +</td>
						</tr>
						<tr>
							<td>MD</td>
							<td>23.5 - 25.0</td>
							<td>25.5 - 28.0</td>
							<td>28.5 +</td>
						</tr>
					{% endif %}
				{% endif %}
			</table>
		</div>
	</div>
</modal-dialog>

{% comment %}
	<div class="size-chart">
	    {% assign variants_size_chart = "" %}

	    {% for variant in product.variants %}
	        {% assign variants_size_chart = variants_size_chart | append: variant.title | append: ":" | append: variant.metafields.size-chart | append: ";" %}
	    {% endfor %}

	    {% assign variants_size_chart = variants_size_chart | split: ";" %}

	    <a href="">size chart</a>

	    <table id="data-table"></table>
	</div>

	<script>
	    var variants_data = {{ variants_size_chart | json }};

	    const variants = variants_data.map(item => {
	        const [key, value] = item.split(":");

	        // Replace "=>" with ":"
	        let jsonString = value.replace(/=>/g, ":");

	        // Replace the comma in sidecut_radius value with a dot
	        jsonString = jsonString.replace(/"(\d+),(\d+)"/g, (match, p1, p2) => {
	            return `"${p1}.${p2}"`;
	        });

	        return { [key]: JSON.parse(jsonString) };
	    });

	    function capitalizeAndReplaceUnderscores(text) {
	        return text.replace(/_/g, ' ').replace(/\b\w/g, char => char.toUpperCase());
	    }

	    function buildTable(data) {
	        const table = document.getElementById('data-table');
	        const sizes = data.map(item => Object.keys(item)[0]);
	        const attributes = Object.keys(data[0][sizes[0]]);

	        // Create header row
	        let headerRow = '<tr><th>SIZE</th>';
	        sizes.forEach(size => {
	            headerRow += `<th>${size}</th>`;
	        });
	        headerRow += '</tr>';
	        table.innerHTML += headerRow;

	        // Create data rows
	        attributes.forEach(attr => {
	            let row = `<tr><td>${capitalizeAndReplaceUnderscores(attr)}`;
	            if(attr == "taper" || attr == "setback") {
	                row = row + " (mm)</td>";
	            } else if (attr == "sidecut_radius") {
	                row = row + " (m)</td>";
	            } else {
	                row = row + " (cm)</td>";
	            }
	            sizes.forEach(size => {
	                const value = data.find(item => item[size])[size][attr];
	                row += `<td>${value !== undefined ? value : ''}</td>`; // Check for undefined and use empty string if true
	            });
	            row += '</tr>';
	            table.innerHTML += row;
	        });
	    }
	    // Build the table on page load
	    buildTable(variants);

	</script>
{% endcomment %}
